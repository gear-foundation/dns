FROM node:24.22.3-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0 AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends g++ make python3 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /squid

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
RUN npm run build \
 && npm prune --omit=dev


FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:6abfcb367ebc291572c774c1592a986be2ab26a2486f73093401327495a5962a AS processor

ENV PROCESSOR_PROMETHEUS_PORT=3000

WORKDIR /squid

COPY package.json ./
COPY --from=build /squid/node_modules ./node_modules
COPY --from=build /squid/lib ./lib
COPY assets ./assets
COPY db ./db

EXPOSE 3000
CMD ["lib/start.js"]
